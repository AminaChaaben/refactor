# Rationale: workers=1 and fullyParallel=false are currently the ONLY thing
# preventing a real race in the crm-workspace suite, where 5 spec files share
# one live, unreset external app instance via the `crmPage` fixture
# (see companion proposal on settings.spec.ts for the full coupling
# evidence). As written, these two lines read as ordinary CI conservatism —
# nothing marks them as load-bearing for test correctness. A future
# contributor optimizing CI runtime could flip either flag without knowing
# it reintroduces cross-file false-fails. Confidence: high.

--- a/playwright.config.ts
+++ b/playwright.config.ts
@@ -9,8 +9,12 @@
 export default defineConfig({
   testDir: './tests/e2e',
   outputDir: './test-results',
+  // fullyParallel/workers below are load-bearing, not just CI tuning:
+  // tests/e2e/crm-workspace/*.spec.ts (5 files) share one live, unreset
+  // external app instance (CRM_URL in crm.fixtures.ts) with no per-test
+  // data isolation. Increasing parallelism here reintroduces real races
+  // between files (see proposals/tests__e2e__crm-workspace__settings.spec.ts.1.patch).
   fullyParallel: false,
   forbidOnly: !!process.env.CI,
   retries: process.env.CI ? 2 : 0,
   workers: process.env.CI ? 1 : 1,
