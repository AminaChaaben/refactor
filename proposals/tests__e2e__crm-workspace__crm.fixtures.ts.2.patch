# Rationale: [Detect Data Issues] Zero afterEach/afterAll teardown exists
# anywhere in this test suite (grep confirmed across tests/). The crmPage
# fixture creates a fresh browser context per test but never resets the
# shared app's server-side state (deals/contacts/notification count), so
# every test that creates data (new deal, new contact) leaves it behind for
# the next test. No reset/purge API for the hosted app was found in the
# graph, so this proposal does not invent one — it documents the gap
# explicitly at the one place every test passes through, so it can't be
# missed by a future contributor adding a new test. Confidence: high on the
# gap being real (exhaustive grep, zero matches); the actual fix (add a
# reset call) is blocked on the hosted app exposing one.

--- a/tests/e2e/crm-workspace/crm.fixtures.ts
+++ b/tests/e2e/crm-workspace/crm.fixtures.ts
@@ -93,9 +93,15 @@
 /** Extend base test with automatic CRM page setup (storageState bypass + navigation). */
 export const test = base.extend<{ crmPage: Page }>({
   crmPage: [
     async ({ browser }, use) => {
       const ctx = await browser.newContext({ storageState: undefined });
       const page = await ctx.newPage();
       await page.goto(CRM_URL);
       await page.locator('#session-badge').waitFor({ state: 'visible' });
       await use(page);
+      // ⚠️ DATA LIFECYCLE HAZARD (Refactor Radar / Ray — Detect Data Issues):
+      // No teardown/reset happens here or anywhere else in this suite. Any
+      // deal/contact this test created remains on the shared hosted app for
+      // every subsequent test (see Detect Dependencies' finding on the same
+      // fixture). If the app ever exposes a reset/purge endpoint, call it
+      // here. Until then, new tests MUST use relative/delta assertions
+      // (read count before, assert delta after) — never assume a zero baseline.
       await ctx.close();
     },
     { scope: 'test' },
   ],
 });
